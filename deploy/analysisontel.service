[Unit]
Description=AnalysisOnTel Telegram BTC Report Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=analysisontel
Group=analysisontel
WorkingDirectory=/opt/analysisontel
EnvironmentFile=/etc/analysisontel.env
ExecStart=/opt/analysisontel/venv/bin/python main.py bot-scheduled
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
