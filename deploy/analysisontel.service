[Unit]
Description=AnalysisOnTel BTC Institutional Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=analysisontel
Group=analysisontel
WorkingDirectory=/opt/analysisontel
EnvironmentFile=/etc/analysisontel.env
ExecStart=/opt/analysisontel/venv/bin/python main.py
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
